# Copy to .env and fill in your real values.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_PILLAR=gpt-4o
OPENAI_MODEL_SAFETY=gpt-4o

# Where the scout writes products.json (read-only from controller)
SCOUT_PRODUCTS_JSON=C:/Projects/amazon-affiliate-scout/data/products.json

# Where to write Astro markdown when publishing
ASTRO_REPO_DIR=C:/Projects/second-spring-club
ASTRO_CONTENT_DIR=C:/Projects/second-spring-club/src/content

# Live site URL (used for post-publish health checks)
SITE_URL=https://secondspringclub.com

# Amazon Associates tag (used in CTAs and sanity checks)
AMAZON_ASSOCIATE_TAG=secondspring-20

# Concurrency limit for parallel OpenAI calls
MAX_PARALLEL_DRAFTS=8

# Auto-push to remote after commit? (true/false)
AUTO_PUSH=true

# Where to save the controller's SQLite DB
CONTROL_DB_PATH=./control.db
